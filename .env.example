# Tender-AI ERP - backend sozlamalari (.env.example dan nusxa oling)
#
# BAZA: tender-ai bilan BIR XIL PostgreSQL. ERP `erp` sxemasida yashaydi,
# `public` sxemasiga faqat O'QISH uchun tegadi (snapshot).
XT_DB_DSN=dbname=xtxarid user=postgres password=PAROL host=localhost
DB_POOL_MIN=1
DB_POOL_MAX=8

# TENDER-AI: backend API va interfeys manzili.
# API - cheklist qoidalari va hujjat turlari uchun.
# WEB - kartadagi "Tender panelini ochish" havolasi uchun.
TENDER_AI_API=http://127.0.0.1:8000
TENDER_AI_WEB=http://localhost:5173
TENDER_AI_TIMEOUT=20

# ERP frontendi alohida domenda ishlaydi - CORS shuning uchun kerak.
# Auth-3 dan keyin tender-ai INTERFEYSI (5173) bu yerga murojaat
# QILMAYDI - u holatni o'z backendidan oladi. Shuning uchun
# ro'yxatda faqat ERP ning o'z interfeysi qoldi.
CORS_ORIGINS=http://localhost:5174,http://127.0.0.1:5174

# Eslatma xabaridagi havola (api/erp/remind.py)
ERP_WEB=http://localhost:5174

# Sessiya muddati (kun). Hodim hisoblari ERP niki (erp.app_user),
# shuning uchun bu sozlama shu yerda.
AUTH_SESSION_DAYS=14

# --- Parol tanlashdan himoya (auth-5) ---
# Cheklov HISOBGA emas, (login + IP) juftligiga tegadi va VAQTINCHA:
# aks holda loginni bilgan har kim hodimni ishdan chiqarib qo'ya olardi.
# Raqamlar ODAM uchun: parolini ikki-uch marta adashib yozgan hodim
# to'silmasin, lug'at bo'yicha urinayotgan dastur esa darhol to'xtasin.
AUTH_ATTEMPT_WINDOW_MIN=15
AUTH_MAX_ATTEMPTS=5
# Bitta IP dan HAMMA loginlar bo'yicha — nom aylantirishga qarshi.
AUTH_MAX_ATTEMPTS_IP=25
# Jurnal shuncha kundan keyin tozalanadi.
AUTH_ATTEMPT_KEEP_DAYS=90

# --- Parol talabi (auth-6) ---
# UZUNLIK talab qilinadi, "katta harf + raqam + belgi" EMAS: murakkablik
# qoidalari `Parol123!` ni keltirib chiqaradi va u monitorga
# yopishtiriladi. Uzun sodda ibora ancha kuchli va yodda qoladi.
AUTH_PASSWORD_MIN=10

# --- Proksi orqasida ishlaganda (auth-5) ---
# Default O'CHIQ. Yoqilsa, mijoz manzili `X-Forwarded-For` ning OXIRGI
# qiymatidan olinadi — uni bizga eng yaqin (ishonchli) proksi qo'yadi.
# Boshidagi qiymatlarni mijozning o'zi yozib yuborishi mumkin, shuning
# uchun ular ISHLATILMAYDI.
# FAQAT nginx/IIS kabi teskari proksi ortida yoqing: to'g'ridan-to'g'ri
# ochiq turgan serverda buni yoqish parol himoyasining IP cheklovini
# chetlab o'tishga yo'l ochadi.
TRUST_PROXY=0

# --- SERVER-SERVER kaliti (auth-2) ---
# ERP <-> Tender-AI chaqiruvlari uchun; ikkala loyihada BIR XIL bo'lsin.
# Yangisini yaratish:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_SERVICE_KEY=

# --- Cookie (auth-4) ---
# Sessiya tokeni HttpOnly cookie'da. `Secure` bayrog'i cookie'ni faqat
# HTTPS orqali yuboradi; brauzerlar `localhost` ni ishonchli deb
# hisoblaydi, shuning uchun ishlab chiqishda ham yoqiq qoladi.
# HTTP orqali BOSHQA manzilda (masalan 192.168.x.x) ochsangiz - 0 qiling,
# aks holda brauzer cookie'ni saqlamaydi va kirish ishlamaydi.
AUTH_COOKIE_SECURE=1

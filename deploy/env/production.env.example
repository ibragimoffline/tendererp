# =============================================================================
# Tender ERP — production muhiti (NAMUNA)
# =============================================================================
# NUSXA: /etc/tendererp/production.env   (0640, root:tendererp)
# Bu fayl NAMUNA va repozitoriyada turadi — SIR YOZMANG.
# `.gitignore` da `deploy/env/*.env` chetlatilgan, faqat `*.env.example`
# kuzatiladi.
#
# Tahrirlash:  sudo -e /etc/tendererp/production.env
# =============================================================================

APP_ENV=production

# --- Tarmoq -------------------------------------------------------------------
# BITTA PORT: `api/main.py` qurilgan `frontend/dist` ni o'zi uzatadi va
# `/api` prefiksini o'zi kesadi. Ya'ni bu port — ham API, ham interfeys.
API_PORT=8100
# 2 ta ishchi: ERP ichki tizim, bir vaqtda o'nlab foydalanuvchi kutilmaydi.
API_WORKERS=2

# Teskari proksi ortida ishlaganda 1 qiling — mijoz manzili
# `X-Forwarded-For` ning OXIRGI qiymatidan olinadi. To'g'ridan-to'g'ri
# ochiq turgan serverda 1 qilish parol himoyasining IP cheklovini
# chetlab o'tishga yo'l ochadi.
TRUST_PROXY=0

# --- Baza — TENDER-AI BILAN BITTA ---------------------------------------------
# ERP `erp` sxemasida yashaydi, `public.*` ga faqat O'QISH uchun tegadi.
# Ilova roli DDL qila olmaydi; migratsiya alohida rol bilan yuriladi.
XT_DB_DSN="dbname=tenderai_production user=erp_service password=ALMASHTIRING host=127.0.0.1 port=5432"
XT_DB_DSN_OWNER="dbname=tenderai_production user=tai_owner password=ALMASHTIRING host=127.0.0.1 port=5432"
DB_POOL_MIN=1
DB_POOL_MAX=8

# --- Tender-AI ----------------------------------------------------------------
# API — cheklist qoidalari, hujjat turlari va eslatma yuborish uchun.
# WEB — kartadagi "Tender panelini ochish" havolasi uchun (brauzer ochadi,
# shuning uchun bu manzil FOYDALANUVCHI ko'radigan manzil bo'lsin).
TENDER_AI_API=http://127.0.0.1:8010
TENDER_AI_WEB=http://localhost:8090
TENDER_AI_TIMEOUT=20

# SERVER-SERVER kaliti. IKKALA loyihada BIR XIL bo'lishi SHART, aks holda
# ERP tender-ai ga kira olmaydi (403).
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
ERP_SERVICE_KEY=

# --- Interfeys ----------------------------------------------------------------
# Nisbiy yo'l. Bu qiymat QURILMAGA singiydi — shuning uchun u hech qachon
# `localhost` bo'lmasin: `deploy.sh` buni tekshiradi va topsa to'xtaydi.
VITE_API_BASE=/api
# Eslatma xabaridagi havola (`api/erp/remind.py`).
ERP_WEB=http://localhost:8100
# Bir xil manba — CORS kerak emas. Interfeys ALOHIDA domenda tursagina
# to'ldiriladi.
CORS_ORIGINS=

# --- Kirish -------------------------------------------------------------------
AUTH_SESSION_DAYS=14
# `Secure` bayrog'i cookie'ni faqat HTTPS orqali yuboradi. Brauzerlar
# `localhost` ni ishonchli deb hisoblaydi, shuning uchun SSH tunnel orqali
# kirishda ham 1 qolaveradi. HTTP orqali BOSHQA manzilda (masalan
# 192.168.x.x) ochsangiz 0 qiling — aks holda kirish JIMGINA ishlamaydi.
AUTH_COOKIE_SECURE=1

# Parol tanlashdan himoya. Cheklov (login + IP) juftligiga tegadi va
# VAQTINCHA: aks holda loginni bilgan har kim hodimni ishdan chiqarib
# qo'ya olardi.
AUTH_ATTEMPT_WINDOW_MIN=15
AUTH_MAX_ATTEMPTS=5
AUTH_MAX_ATTEMPTS_IP=25
AUTH_ATTEMPT_KEEP_DAYS=90
# UZUNLIK talab qilinadi, "katta harf + raqam + belgi" EMAS.
AUTH_PASSWORD_MIN=10

# --- Jurnal -------------------------------------------------------------------
# `api/main.py` jurnalni `<reliz>/logs/erp.log` ga yozadi; `deploy.sh` u
# yo'lni `var/logs` ga havola qiladi, shuning uchun jurnal relizdan
# TASHQARIDA qoladi va joylashtirishda yo'qolmaydi.
LOG_KEEP_FILES=7
LOG_MAX_MB=10
